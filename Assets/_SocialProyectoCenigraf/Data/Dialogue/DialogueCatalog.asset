  - id: Recepcionista_entrega_de_carnet
    speakerCharacterId: NPC_Recepcionista_Lobby
    startNodeId: Line1
    conditionalStartRoutes:
    - conditionType: 0
      conditionId: carnet_estudiantil
      targetNodeId: AlreadyHasCarnet
    nodes:
    - id: Line1
      speaker: Recepcionista del Lobby
      text: Hola, debes ser *NAME*, te estaba esperando para poder entregarte tu
        Carnet de Aprendiz.
      nextNodeId: Line2
      options: []
      conditionalRoutes: []
      completionReward: {fileID: 0}
      completionItemCatalog: {fileID: 0}
