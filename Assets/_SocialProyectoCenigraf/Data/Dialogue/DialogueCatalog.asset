  dialogues:
  - id: Sala_ABC_Bienvenida
    speakerCharacterId: 
    startNodeId: Line1
    conditionalStartRoutes: []
    nodes:
    - id: Line1
      speaker: Recepcionista de Sala ABC
      text: "Bienvenido a la sala ABC del SENA aqu\xED compartimos, aprendemos y
        construimos el futuro juntos.\n\n\xBFDeseas tener m\xE1s informaci\xF3n del
        ABC SENA?"
      nextNodeId: 
      options:
      - key: Si
        text: "S\xED"
        nextNodeId: Line2
      - key: No
        text: No
        nextNodeId: Line8
      conditionalRoutes: []
      completionReward: {fileID: 0}
      completionItemCatalog: {fileID: 0}
      completionItemId: 
      completionItemQuantity: 1
    - id: Line2
      speaker: Recepcionista de Sala ABC
      text: "La Sala ABC es un lugar donde se entiende qu\xE9 es el SENA, c\xF3mo
        funciona, qu\xE9 ofrece y c\xF3mo se articula con las empresas y los aprendices
        para fortalecer el aprendizaje y el empleo en Colombia."
      nextNodeId: 
      options:
      - key: Default
        text: 
        nextNodeId: Line3
      conditionalRoutes: []
      completionReward: {fileID: 0}
      completionItemCatalog: {fileID: 0}
      completionItemId: 
      completionItemQuantity: 1
    - id: Line3
      speaker: Recepcionista de Sala ABC
      text: "Ya teniendo claro qu\xE9 es la Sala ABC, conocer\xE1s informaci\xF3n
        importante acerca de la etapa de inducci\xF3n."
      nextNodeId: 
      options:
      - key: Default
        text: 
        nextNodeId: Line4
      conditionalRoutes: []
      completionReward: {fileID: 0}
      completionItemCatalog: {fileID: 0}
      completionItemId: 
      completionItemQuantity: 1
    - id: Line4
      speaker: Recepcionista de Sala ABC
      text: Dime un tema que te interese.
      nextNodeId: 
      options:
      - key: MisionYVision
        text: "Misi\xF3n y visi\xF3n"
        nextNodeId: Line5
      - key: QueActividadesHaceElAprendiz
        text: "Qu\xE9 actividades hace el aprendiz"
        nextNodeId: Line6
      conditionalRoutes: []
      completionReward: {fileID: 0}
      completionItemCatalog: {fileID: 0}
      completionItemId: 
      completionItemQuantity: 1
    - id: Line5
      speaker: Recepcionista de Sala ABC
      text: "Misi\xF3n del SENA\n\nLa misi\xF3n est\xE1 definida en la Ley 119 de
        1994: El SENA cumple la funci\xF3n del Estado de invertir en el desarrollo
        social y t\xE9cnico de los trabajadores colombianos, ofreciendo formaci\xF3n
        profesional integral que permita a las personas incorporarse y desarrollarse
        en actividades productivas."
      nextNodeId: 
      options:
      - key: Default
        text: 
        nextNodeId: Line7
      conditionalRoutes: []
      completionReward: {fileID: 0}
      completionItemCatalog: {fileID: 0}
      completionItemId: 
      completionItemQuantity: 1
    - id: Line6
      speaker: Recepcionista de Sala ABC
      text: "[Contenido pendiente: aqu\xED puedes escribir la informaci\xF3n sobre
        las actividades que realiza el aprendiz.]"
      nextNodeId: 
      options:
      - key: Default
        text: 
        nextNodeId: Line7
      conditionalRoutes: []
      completionReward: {fileID: 0}
      completionItemCatalog: {fileID: 0}
      completionItemId: 
      completionItemQuantity: 1
    - id: Line7
      speaker: Recepcionista de Sala ABC
      text: "\xBFTienes m\xE1s inquietudes?"
      nextNodeId: 
      options:
      - key: NoPorElMomento
        text: No por el momento
        nextNodeId: Line8
      - key: SiTengo
        text: "S\xED, tengo"
        nextNodeId: Line4
      conditionalRoutes: []
      completionReward: {fileID: 0}
      completionItemCatalog: {fileID: 0}
      completionItemId: 
      completionItemQuantity: 1
    - id: Line8
      speaker: Recepcionista de Sala ABC
      text: "\xA1Gracias por tu inter\xE9s! Aqu\xED estar\xE9 si necesitas m\xE1s
        informaci\xF3n."
      nextNodeId: '*END*'
      options: []
      conditionalRoutes: []
      completionReward: {fileID: 0}
      completionItemCatalog: {fileID: 0}
      completionItemId: 
      completionItemQuantity: 1
