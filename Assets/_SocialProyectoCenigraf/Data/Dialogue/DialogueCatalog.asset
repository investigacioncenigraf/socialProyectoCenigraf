      completionItemQuantity: 1
    - id: Line3
      speaker: Recepcionista del Lobby
      text: "Con este carnet ya puedes acceder a m\xE1s zonas y muchas ventajas que
        a futuro descubrir\xE1s."
      nextNodeId: Line4
