  m_Script: {fileID: 11500000, guid: 3d7b1c6a9e2f44f18ab5c0d7e9341a62, type: 3}
  m_Name: PruebaDeLaOrientacion_Questions
  m_EditorClassIdentifier: 
  catalogName: 'Prueba de la Orientación'
  questions:
  - prompt: '¿La A final de la sigla SENA significa...?'
    correctAnswer: 'Aprendizaje'
    falseAnswer1: 'Agricultura'
    falseAnswer2: 'Astronomía'
  - prompt: '¿En qué país funciona el SENA?'
    correctAnswer: 'Colombia'
    falseAnswer1: 'Chile'
    falseAnswer2: 'España'
  - prompt: '¿En qué año se creó el SENA?'
    correctAnswer: '1957'
    falseAnswer1: '1985'
    falseAnswer2: '2003'
  - prompt: '¿Quién fue el fundador del SENA?'
    correctAnswer: 'Rodolfo Martínez'
    falseAnswer1: 'Simón Bolívar'
    falseAnswer2: 'Jorge Isaacs'
  - prompt: '¿A qué ministerio está adscrito el SENA?'
    correctAnswer: 'Trabajo'
    falseAnswer1: 'Minas'
    falseAnswer2: 'Cultura'
  - prompt: '¿El SENA es una entidad pública o privada?'
    correctAnswer: 'Pública'
    falseAnswer1: 'Privada'
    falseAnswer2: 'Extranjera'
  - prompt: '¿Cuánto cuesta estudiar en el SENA?'
    correctAnswer: 'Nada, es gratis'
    falseAnswer1: 'Medio salario'
    falseAnswer2: 'Según la nota'
  - prompt: '¿Cómo se le dice al estudiante del SENA?'
    correctAnswer: 'Aprendiz'
    falseAnswer1: 'Becario'
    falseAnswer2: 'Cadete'
  - prompt: '¿Cómo se le dice al profesor del SENA?'
    correctAnswer: 'Instructor'
    falseAnswer1: 'Rector'
    falseAnswer2: 'Capataz'
  - prompt: '¿Cómo se llama la sede del SENA donde se estudia?'
    correctAnswer: 'Centro de formación'
    falseAnswer1: 'Sucursal'
    falseAnswer2: 'Cuartel'
  - prompt: '¿En cuántos departamentos del país hay SENA?'
    correctAnswer: 'En todos'
    falseAnswer1: 'Solo en tres'
    falseAnswer2: 'Solo en Bogotá'
  - prompt: '¿Con qué dinero funciona el SENA?'
    correctAnswer: 'Aportes de empresas'
    falseAnswer1: 'Pagos de aprendices'
    falseAnswer2: 'Rifas'
  - prompt: '¿El SENA tiene himno propio?'
    correctAnswer: 'Sí'
    falseAnswer1: 'No'
    falseAnswer2: 'Solo bandera'
  - prompt: 'En el SENA, ¿qué significa aprender haciendo?'
    correctAnswer: 'Practicar lo visto'
    falseAnswer1: 'Copiar al vecino'
    falseAnswer2: 'Memorizar todo'
  - prompt: '¿Qué título entrega un programa del SENA de dos años?'
    correctAnswer: 'Tecnólogo'
    falseAnswer1: 'Técnico'
    falseAnswer2: 'Doctorado'
  - prompt: '¿Cuál programa del SENA dura menos?'
    correctAnswer: 'El técnico'
    falseAnswer1: 'El tecnólogo'
    falseAnswer2: 'Duran igual'
  - prompt: 'En el SENA, ¿cómo se llama la formación que da título?'
    correctAnswer: 'Titulada'
    falseAnswer1: 'Complementaria'
    falseAnswer2: 'Express'
  - prompt: 'En el SENA, ¿cómo se llama la formación de cursos cortos?'
    correctAnswer: 'Complementaria'
    falseAnswer1: 'Titulada'
    falseAnswer2: 'Vacacional'
  - prompt: 'En el SENA, ¿qué nivel sigue después del tecnólogo?'
    correctAnswer: 'Especialización'
    falseAnswer1: 'Primaria'
    falseAnswer2: 'Bachillerato'
  - prompt: '¿El SENA ofrece programas virtuales?'
    correctAnswer: 'Sí'
    falseAnswer1: 'No, solo presenciales'
    falseAnswer2: 'Solo los sábados'
  - prompt: '¿El SENA dicta cursos de inglés?'
    correctAnswer: 'Sí'
    falseAnswer1: 'No'
    falseAnswer2: 'Solo en Bogotá'
  - prompt: '¿El SENA solo enseña oficios manuales?'
    correctAnswer: 'No'
    falseAnswer1: 'Sí'
    falseAnswer2: 'Solo mecánica'
  - prompt: '¿Una persona de 40 años puede estudiar en el SENA?'
    correctAnswer: 'Sí'
    falseAnswer1: 'No, hasta los 25'
    falseAnswer2: 'Solo con permiso'
  - prompt: '¿Se puede estudiar en el SENA sin ser bachiller?'
    correctAnswer: 'Sí, en varios cursos'
    falseAnswer1: 'Nunca'
    falseAnswer2: 'Solo con tutela'
  - prompt: '¿Se puede estudiar en el SENA y trabajar a la vez?'
    correctAnswer: 'Sí, hay jornadas'
    falseAnswer1: 'No'
    falseAnswer2: 'Solo de noche'
  - prompt: '¿En qué plataforma se hace hoy la inscripción al SENA?'
    correctAnswer: 'Betowa'
    falseAnswer1: 'Un formulario físico'
    falseAnswer2: 'El correo postal'
  - prompt: '¿Qué plataforma usaba el SENA antes de Betowa?'
    correctAnswer: 'Sofia Plus'
    falseAnswer1: 'Zoom'
    falseAnswer2: 'Ninguna'
  - prompt: '¿Cuánto cuesta inscribirse a un programa del SENA?'
    correctAnswer: 'Nada'
    falseAnswer1: 'Un salario'
    falseAnswer2: 'Según el programa'
  - prompt: '¿Se necesita un intermediario para inscribirse al SENA?'
    correctAnswer: 'No'
    falseAnswer1: 'Sí, un abogado'
    falseAnswer2: 'Sí, un tramitador'
  - prompt: '¿Qué documento piden para inscribirse al SENA?'
    correctAnswer: 'El de identidad'
    falseAnswer1: 'El carné del gimnasio'
    falseAnswer2: 'El pase de conducción'
  - prompt: '¿Las inscripciones del SENA están abiertas todo el año?'
    correctAnswer: 'No, por convocatorias'
    falseAnswer1: 'Sí, siempre'
    falseAnswer2: 'Solo en enero'
  - prompt: 'Después de inscribirse al SENA, ¿qué viene?'
    correctAnswer: 'La prueba de selección'
    falseAnswer1: 'La fiesta de grado'
    falseAnswer2: 'Nada más'
  - prompt: '¿Dónde se ven los resultados de la selección del SENA?'
    correctAnswer: 'En la plataforma'
    falseAnswer1: 'En el periódico'
    falseAnswer2: 'En la emisora'
  - prompt: '¿Qué hace quien queda seleccionado en el SENA?'
    correctAnswer: 'Matricularse'
    falseAnswer1: 'Esperar un año'
    falseAnswer2: 'Inscribirse otra vez'
  - prompt: '¿Qué puede hacer quien no queda seleccionado en el SENA?'
    correctAnswer: 'Intentar otra vez'
    falseAnswer1: 'Nada, queda vetado'
    falseAnswer2: 'Pagar el cupo'
  - prompt: '¿La matrícula del SENA tiene costo?'
    correctAnswer: 'No, ninguno'
    falseAnswer1: 'Solo la primera'
    falseAnswer2: 'La mitad del curso'
  - prompt: '¿Quién resuelve las dudas sobre la inscripción al SENA?'
    correctAnswer: 'El mismo SENA'
    falseAnswer1: 'Un tramitador'
    falseAnswer2: 'Un vecino'
  - prompt: '¿Qué se lleva el primer día de formación en el SENA?'
    correctAnswer: 'Documento y ganas'
    falseAnswer1: 'Uniforme militar'
    falseAnswer2: 'Computador propio'
  - prompt: 'En el SENA, ¿cómo se llama la etapa de clases?'
    correctAnswer: 'Lectiva'
    falseAnswer1: 'Productiva'
    falseAnswer2: 'Recreativa'
  - prompt: 'En el SENA, ¿cómo se llama la etapa de práctica?'
    correctAnswer: 'Productiva'
    falseAnswer1: 'Lectiva'
    falseAnswer2: 'De descanso'
  - prompt: '¿Qué es el contrato de aprendizaje del SENA?'
    correctAnswer: 'La práctica en empresa'
    falseAnswer1: 'Un préstamo'
    falseAnswer2: 'Un seguro'
  - prompt: '¿El aprendiz del SENA recibe apoyo durante su práctica?'
    correctAnswer: 'Sí, económico'
    falseAnswer1: 'No, nada'
    falseAnswer2: 'Solo en diciembre'
  - prompt: '¿Qué entrega el SENA al terminar un programa?'
    correctAnswer: 'Un certificado'
    falseAnswer1: 'Una medalla'
    falseAnswer2: 'El diploma del colegio'
  - prompt: '¿El certificado del SENA sirve para buscar trabajo?'
    correctAnswer: 'Sí'
    falseAnswer1: 'Solo para decorar'
    falseAnswer2: 'Solo un año'
  - prompt: '¿Para qué sirve la Agencia Pública de Empleo del SENA?'
    correctAnswer: 'Buscar trabajo'
    falseAnswer1: 'Viajar barato'
    falseAnswer2: 'Pedir préstamos'
  - prompt: '¿Para qué sirve el Fondo Emprender del SENA?'
    correctAnswer: 'Crear empresa'
    falseAnswer1: 'Pagar la pensión'
    falseAnswer2: 'Comprar carro'
  - prompt: '¿Qué es un Tecnoparque del SENA?'
    correctAnswer: 'Espacio de innovación'
    falseAnswer1: 'Parque de diversiones'
    falseAnswer2: 'Un parqueadero'
  - prompt: '¿El SENA acompaña a quien quiere crear su empresa?'
    correctAnswer: 'Sí'
    falseAnswer1: 'No'
    falseAnswer2: 'Solo a ingenieros'
  - prompt: '¿Qué pasa si un aprendiz falta mucho a la formación?'
    correctAnswer: 'Puede perder el cupo'
    falseAnswer1: 'No pasa nada'
    falseAnswer2: 'Se gradúa igual'
  - prompt: '¿El SENA forma personas solo para empresas grandes?'
    correctAnswer: 'No'
    falseAnswer1: 'Sí'
    falseAnswer2: 'Solo para el Estado'
